    {
      "name": "Surf Spots CRUD",
      "item": [
        {
          "name": "List Surf Spots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/surf-spots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "surf-spots"]
            }
          }
        },
        {
          "name": "Get Surf Spot by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/surf-spots/{{surfSpotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "surf-spots", "{{surfSpotId}}"]
            }
          }
        },
        {
          "name": "Create Surf Spot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('createdSurfSpotId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Surf Spot {{$timestamp}}\",\n  \"country\": \"Spain\",\n  \"region\": \"Canary Islands\",\n  \"latitude\": 28.0443,\n  \"longitude\": -16.5364,\n  \"difficulty\": \"INTERMEDIATE\",\n  \"bestWindDirection\": \"North\",\n  \"bestSwellDirection\": \"West\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/surf-spots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "surf-spots"]
            }
          }
        },
        {
          "name": "Update Created Surf Spot",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Updated Surf Spot {{$timestamp}}\",\n  \"country\": \"Spain\",\n  \"region\": \"Canary Islands\",\n  \"latitude\": 28.0443,\n  \"longitude\": -16.5364,\n  \"difficulty\": \"ADVANCED\",\n  \"bestWindDirection\": \"East\",\n  \"bestSwellDirection\": \"Northwest\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/surf-spots/{{createdSurfSpotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "surf-spots", "{{createdSurfSpotId}}"]
            }
          }
        },
